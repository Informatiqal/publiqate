// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "DEBUG",
    "adapter": "JavaScript",
    "type": "node",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}\\dist\\index.js",
    "webRoot": "${ZED_WORKTREE_ROOT}",
    "build": {
      "command": "npm",
      "args": ["run", "build"],
    },
    "skipFiles": ["<node_internals>/**"],
    "outFiles": ["${ZED_WORKTREE_ROOT}/dist/**/*.js", "!**/node_modules/**"],
  },
]
