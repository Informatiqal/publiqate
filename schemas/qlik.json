{
    "$schema": "http://json-schema.org/draft-07/schema",
    "title": "JSON Schema for Publiqate config file",
    "description": "Publiqate config JSON schema (@informatiqal)",
    "type": "array",
    "minItems": 1,
    "items": {
        "type": "object",
        "properties": {
            "name": {
                "type": "string"
            },
            "certs": {
                "type": "string"
            },
            "host": {
                "type": "string"
            },
            "userName": {
                "type": "string"
            },
            "userDir": {
                "type": "string"
            }
        },
        "required": [
            "name",
            "certs",
            "host"
        ],
        "additionalProperties": false
    }
}